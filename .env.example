# Copy to .env.local and fill in (never put real keys in this file)
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key

# ZCTA vector tiles (DO Spaces or Supabase public URL)
NEXT_PUBLIC_PMTILES_URL=

# Basemap style JSON (optional; default Carto Voyager — same family as dashboard light_all)
NEXT_PUBLIC_MAP_STYLE_URL=

# Local dev: skip login (never on production)
DISABLE_AUTH=true
# Optional: auto-creates dev@local.test if missing
# DEV_USER_EMAIL=dev@local.test
# DEV_USER_PASSWORD=devpassword123
# DEV_USER_ID=

# Geocoding + Places (required for client/competitor lookup)
GOOGLE_PLACES_API_KEY=
# Legacy alias also accepted:
# GOOGLE_GEOCODING_API_KEY=
